[Unit]
Description=odds-api.io ingester (BetsSolution v2 sportsbook)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/betssolution-admin/services/odds-api-ingester
EnvironmentFile=/root/betssolution-admin/services/odds-api-ingester/.env
Environment=PATH=/root/.nvm/versions/node/v20.20.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/root/.nvm/versions/node/v20.20.0/bin/node --max-old-space-size=1536 /root/.nvm/versions/node/v20.20.0/bin/npx tsx src/scheduler.ts
Restart=always
RestartSec=10
StandardOutput=append:/var/log/odds-api-ingester.log
StandardError=append:/var/log/odds-api-ingester.log
SyslogIdentifier=odds-api-ingester
# Limit memory to prevent runaway
MemoryMax=2G

[Install]
WantedBy=multi-user.target
